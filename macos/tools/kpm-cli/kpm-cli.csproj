<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives KotOR Patch Manager's own KPatchCore library; see Program.cs.
       Build with: dotnet build -c Release -p:KpmRoot=/path/to/Kotor-Patch-Manager -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KpmRoot)/src/KPatchCore/KPatchCore.csproj" />
  </ItemGroup>
</Project>
