+# ---------------------------------------------------------------------------
+# Memory safety, adopted from the Kotor Patch Manager project (VexFlint).
+#
+# These are not controller hooks. They live in this table because it is the only
+# hook table KMRP ships, and because they are the difference between "KMRP loads
+# far more data than vanilla" being fine and being a corruption.
+#
+# Byte patches, not detours: no function is named, the runtime writes the
+# replacement and jumps. Bytes copied verbatim from KPM rather than re-derived,
+# so this is the behaviour that was reviewed there.
+
+# --- Texture bucket memory safety -----------------------------------------
+#
+# Three 5000-entry arrays are indexed by driver-assigned GL texture names with
+# no range check. Verified independently in this image:
+#
+#   AurTextureGetMaxTexID  0x0041FEB0  mov eax,[0x007A46BC] ; ret  -- unclamped
+#   AddPartToMeshBuckets   0x0046BE67  mov eax,[esi*4 + 0x008194E8]
+#                                      base 0x008194E0, stride 12, index = tid
+#
+# maxTexID is written by AurTextureBuildAndStoreAll at 0x0042192F and only ever
+# rises, so this gets more likely the longer a session runs and the more
+# textures it loads. See reverse-engineering/experiments/texture-bucket-overrun.md.
+
+# Saturate AurTextureGetMaxTexID's return at 4999. Saturating rather than
+# masking: an AND would wrap a legitimate 4500 down to 404 and leave stale
+# buckets uncleared.
+[[hooks]]
+address = 0x0041FEB5
+type = "replace"
+original_bytes = [0xC3, 0x90, 0x90, 0x90, 0x90]
+replacement_bytes = [
+    0x3D, 0x88, 0x13, 0x00, 0x00, 0x72, 0x05, 0xB8,
+    0x87, 0x13, 0x00, 0x00, 0xC3
+]
+exclude_from_restore = []
+
+# Range-check the texture id in AddPartToMeshBuckets. An out-of-range part skips
+# the bucket insert and rejoins at 0x0046BEB1, which preserves shadow casting;
+# it is unreachable by the renderer anyway, since DoMeshBuckets iterates the
+# clamped ordering list.
+[[hooks]]
+address = 0x0046BE64
+type = "replace"
+original_bytes = [
+    0x8D, 0x34, 0x40, 0x8B, 0x04, 0xB5, 0xE8, 0x94,
+    0x81, 0x00
+]
+replacement_bytes = [
+    0x3D, 0x88, 0x13, 0x00, 0x00, 0x72, 0x13, 0xA1,
+    0xBC, 0xBF, 0x7F, 0x00, 0x8B, 0x0D, 0xB8, 0xBF,
+    0x7F, 0x00, 0x3B, 0xC8, 0x68, 0xB1, 0xBE, 0x46,
+    0x00, 0xC3, 0x8D, 0x34, 0x40, 0x8B, 0x04, 0xB5,
+    0xE8, 0x94, 0x81, 0x00
+]
+exclude_from_restore = []
