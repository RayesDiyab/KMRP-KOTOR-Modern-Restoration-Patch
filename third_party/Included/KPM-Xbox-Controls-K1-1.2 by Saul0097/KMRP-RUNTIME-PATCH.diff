+# ---------------------------------------------------------------------------
+# Native joystick path. Feeds XInput into KOTOR's own retained joystick
+# pipeline instead of synthesising keystrokes. See
+# reverse-engineering/retained-xbox-gui-events.md for the measurements behind
+# every address here.
+# ---------------------------------------------------------------------------
+
+# Register the joystick descriptions and raise the device count, once the input
+# singleton exists. Idempotent; runs every frame and returns immediately after
+# the first success.
+[[hooks]]
+address = 0x005E24E0
+type = "detour"
+function = "NativeJoystickInitK1"
+original_bytes = [0x6A, 0xFF, 0x68, 0xFD, 0x48, 0x72, 0x00]
+skip_original_bytes = false
+exclude_from_restore = []
+
+[[hooks.parameters]]
+source = "ecx"
+type = "pointer"
+
+# Replace CExoRawInputInternal::GetJoystickBuffer. Hooked past the entry, where
+# esi holds the caller's record buffer -- at the true entry it is still only on
+# the stack, and hook parameters come from registers. ebx, esi and edi are all
+# pushed by this point, so the consumed exit unwinds correctly, and GetEvents
+# ignores this function's return value.
+[[hooks]]
+address = 0x005E30F6
+type = "detour"
+function = "NativeJoystickBufferK1"
+original_bytes = [0x89, 0x5C, 0x24, 0x2C, 0x74, 0x0F]
+skip_original_bytes = true
+consumed_exit_address = 0x005E319B
+exclude_from_restore = ["eax"]
+
+[[hooks.parameters]]
+source = "esi"
+type = "pointer"
+
+# Override the movement axes at the single point every control scheme passes
+# through. ProcessInput has already clamped the keyboard values into +0x10 and
+# +0x14 by here, so the stick only displaces them when it is outside the
+# deadzone -- keyboard movement is untouched otherwise.
+[[hooks]]
+address = 0x00679940
+type = "detour"
+function = "NativeJoystickMovementK1"
+original_bytes = [0xD9, 0x05, 0x64, 0xD7, 0x73, 0x00]
+skip_original_bytes = false
+exclude_from_restore = []
+
+[[hooks.parameters]]
+source = "ecx"
+type = "pointer"
+
+# Bypass Control's own Vector::Normalize, but only while the stick is driving.
+# That call is correct for the keyboard, where each axis is exactly +/-1 and an
+# unnormalised diagonal would be sqrt(2) too fast. It is wrong for analog: it
+# would rescale a half-deflected diagonal back to full speed. The handler
+# returns zero for keyboard and mouse, so vanilla behaviour is untouched.
+#
+# Verified safe to skip: Vector::Normalize is __thiscall taking only the vector,
+# touches no globals, balances its own stack, and its return value is dead --
+# 0x00679B76 overwrites eax immediately. The x87 stack is empty at the call site.
+[[hooks]]
+address = 0x00679B71
+type = "detour"
+function = "NativeJoystickSkipNormalizeK1"
+original_bytes = [0xE8, 0xBA, 0x15, 0xE3, 0xFF]
+skip_original_bytes = true
+consumed_exit_address = 0x00679B76
+exclude_from_restore = ["eax"]
+
+[[hooks.parameters]]
+source = "ecx"
+type = "pointer"
