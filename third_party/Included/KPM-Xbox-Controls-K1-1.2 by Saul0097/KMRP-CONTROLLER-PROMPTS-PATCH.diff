+        g_mouseWindowStart = now;
+        g_mouseWindowDistance = 0;
+        g_mouseWindowEvents = 0;
+    }
+    g_mouseWindowDistance += (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+    ++g_mouseWindowEvents;
