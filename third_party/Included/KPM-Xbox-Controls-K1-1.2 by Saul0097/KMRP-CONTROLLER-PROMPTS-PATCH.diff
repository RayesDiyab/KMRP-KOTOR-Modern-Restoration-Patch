+# Poll XInput once per Bink frame; the normal ProcessInput hook does not run
+# while a movie owns the game loop.
+#
+# This must sit INSIDE the loop, not at the function entry. 0x00404C80 is
+# CExoMoviePlayerInternal::PlayMovieLoop, and the name is literal: the playback
+# loop is inside it, running 0x00404CB5 -> 0x00404D9F. A detour on the prologue
+# therefore fired exactly once, before the first frame, so no button pressed
+# during a movie was ever seen. 0x00404D96 is the tail of the loop body and runs
+# once per iteration.
+#
+# The parameter comes from ESI, not ECX. `this` is copied out of ECX into ESI at
+# 0x00404C87 and every later access in the loop is [esi+0x48] / [esi+0x4c]; ECX
+# is a scratch register by this point.
+#
+# original_bytes covers two whole instructions -- mov eax,[esi+0x48] and
+# mov ecx,[eax+8] -- so the re-executed prologue leaves eax and ecx exactly as
+# the following cmp/jne expects.
+[[hooks]]
+address = 0x00404D96
+type = "detour"
+function = "PollMovieControllerK1"
+original_bytes = [0x8B, 0x46, 0x48, 0x8B, 0x48, 0x08]
+skip_original_bytes = false
+exclude_from_restore = []
+
+[[hooks.parameters]]
+source = "esi"
+type = "pointer"
+
 # Process captured keyboard input during the gameplay HUD update.
 [[hooks]]
