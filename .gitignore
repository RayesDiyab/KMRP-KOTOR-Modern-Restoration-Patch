# Proprietary game binaries and analysis artifacts
*.exe
*.dll
*.bif
*.key
*.erf
*.rim
*.mod
*.sav
reverse-engineering/binaries/*
!reverse-engineering/binaries/README.md

# Debugger output
*.dd32
*.dd64
*.dmp
*.trace32
*.trace64
*.1337

# Generated logs and temporary files
logs/
tmp/
build/
*.log

# Python bytecode
__pycache__/
*.pyc

# Hand-edit backups of Override GUI files
*.gui.bak

# Build output and local scratch
dist/
.spec-render/

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Test-run artifacts. The verify-* folders are .gui dumps produced by a patcher
# run at one resolution -- regenerate them rather than storing them (see
# testing/README.md). latest-generated-*-path.txt records an absolute path from
# whichever machine produced them.
testing/virtual-display/verify-*/
testing/virtual-display/latest-generated-*-path.txt

# Vendored third-party driver package. Obtain it from the upstream project and
# verify the SHA-256 recorded in testing/virtual-display/README.md instead.
testing/virtual-display/VDD.Control.*/
testing/virtual-display/VDD.Control.*.zip

# Game-derived build inputs. Kept inside the project so it is self-contained,
# but never committed -- these are BioWare's files. See build-inputs/README.md.
build-inputs/*
!build-inputs/README.md

# Machine-specific build settings (build.local.example.ps1 is the template).
build.local.ps1

# Third-party mods downloaded for comparison only. Kept locally so their code can
# be inspected; NOT redistributed here -- we have no permission to. The patterns are
# depth-independent because these were reorganised into third_party/Included/ and the
# old fixed-depth rules silently stopped matching, which staged ~800 files of other
# people's work for commit. Anything that lands in third_party is ignored by default
# and un-ignored deliberately, below.
third_party/**/K1-Area-Map-Fixes-*/
third_party/**/K1-Area-Map-Fixes-*.zip
third_party/**/k1-area-map-fixes-*/
third_party/**/Vanilla Maps HD (K1)/
third_party/**/Vanilla Maps HD (K1).zip
third_party/**/KoToR1IconMOD/
third_party/**/KoToR1IconMOD.rar

# Vendored redistributable: the K1 Modern Driver Compatibility standalone build
# (Synchro, MPL-2.0), shipped inside the patcher with the author's permission. The
# global *.dll rule above would otherwise drop the proxy DLL from the release we
# distribute. See docs/third-party-driver-compat.md.
!third_party/Included/k1-modern-driver-compatibility-*/dinput8.dll
!third_party/Included/k1-modern-driver-compatibility-*/*.asi
