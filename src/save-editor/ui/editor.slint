// The editor, shaped like the game's in-game menu: tabs across the top, the party down
// the left, and every value changed where it is shown. A changed value turns orange
// until it is saved.

import { Theme } from "theme.slint";
import { App, Stat, Named, ItemRow, NpcRow, GlobalRow, DoorRow, BoxRow, Toggle } from "state.slint";
import { Button, Stepper, Field, Switch, Label, Note, Scroller, Cross, Sign, BackArrow } from "widgets.slint";

component Line inherits Rectangle {
    height: 56px;
    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
}

component StatLine inherits Line {
    in property <Stat> stat;
    in property <length> label-size: 19px;
    callback set(int);
    height: stat.note != "" ? 60px : 52px;
    HorizontalLayout {
        spacing: 12px;
        if stat.has-icon: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 4px;
                background: Theme.field;
                clip: true;
                Image { source: stat.icon; width: parent.width; height: parent.height; }
            }
        }
        VerticalLayout {
            alignment: center;
            Text { text: stat.label; font-family: Theme.list-font; font-size: label-size; color: Theme.text; overflow: elide; }
            if stat.note != "": Text { text: stat.note; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Stepper {
                width: 140px;
                value: stat.value;
                minimum: stat.minimum;
                maximum: stat.maximum;
                changed: stat.changed;
                set(v) => { root.set(v); }
            }
        }
        if stat.mod != "": Text {
            width: 40px;
            text: stat.mod;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: Theme.list-font;
            font-size: 17px;
            color: Theme.muted;
        }
    }
}

// Every feat or power the game has, in its groups, with its icon. What the character
// has is lit, with a cross to remove it; the rest have a plus. Typing narrows the list.
component AbilityList inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> placeholder;
    in property <[Named]> rows;
    in property <bool> enabled: true;
    callback search(string);
    callback add(int);
    callback remove(int);
    in-out property <string> query;
    HorizontalLayout {
        x: 0;
        y: 0;
        height: 24px;
        Label { text: title; }
        Note { text: hint; horizontal-alignment: right; vertical-alignment: center; }
    }
    Field {
        x: 0;
        y: 34px;
        height: 40px;
        text <=> query;
        placeholder: root.placeholder;
        font: Theme.body-font;
        font-size: 15px;
        read-only: !enabled;
        edited(t) => { root.search(t); }
    }
    Scroller {
        x: 0;
        y: 84px;
        height: parent.height - 84px;
        content-height: rows.length * 50px;
        VerticalLayout {
            for r in rows: Rectangle {
                height: 50px;
                background: r.owned ? Theme.selected : transparent;
                border-radius: 5px;
                if r.header: Label { x: 4px; y: 22px; text: r.name; font-size: 13px; color: Theme.soft; }
                if !r.header: Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                if !r.header: HorizontalLayout {
                    padding-left: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 38px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 38px;
                                border-radius: 4px;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: r.owned ? Theme.accent : Theme.edge;
                                clip: true;
                                if r.has-icon: Image { source: r.icon; width: parent.width; height: parent.height; }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: r.name;
                            font-family: Theme.list-font;
                            font-size: 16px;
                            color: r.changed ? Theme.changed : r.owned ? Theme.gold : Theme.text;
                            overflow: elide;
                        }
                        if r.note != "": Text { text: r.note; font-family: Theme.body-font; font-size: 12px; color: Theme.faint; overflow: elide; }
                    }
                    Rectangle {
                        width: 40px;
                        if !r.owned && root.enabled: Sign { plus: true; colour: act.has-hover ? Theme.text : Theme.accent; }
                        if r.owned: Cross { colour: act.has-hover ? Theme.danger : Theme.faint; }
                        act := TouchArea {
                            enabled: root.enabled || r.owned;
                            mouse-cursor: pointer;
                            clicked => { if (r.owned) { root.remove(r.id); } else { root.add(r.id); } }
                        }
                    }
                }
            }
        }
    }
}

component CharacterTab inherits Rectangle {
    property <length> colw: (self.width - 2 * 34px) / 3;
    // Who
    Rectangle {
        x: 0;
        width: colw;
        Label { x: 0; y: 0; text: "WHO"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            spacing: 0px;
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: 130px; text: "Name"; vertical-alignment: center; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            text: App.name;
                            changed: App.name-changed;
                            accepted(t) => { App.set-name(t); }
                            edited(t) => { App.set-name(t); }
                        }
                    }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: 130px; text: "Classes"; vertical-alignment: center; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
                    VerticalLayout { alignment: center; Field { text: App.classes; read-only: true; font: Theme.body-font; font-size: 14px; } }
                    VerticalLayout { alignment: center; Button { kind: 3; text: "Edit"; clicked => { App.open-classes(); } } }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: 130px; text: "Experience"; vertical-alignment: center; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
                    VerticalLayout {
                        alignment: center;
                        Field {
                            text: App.xp;
                            changed: App.xp-changed;
                            accepted(t) => { App.set-xp(t.to-float()); }
                        }
                    }
                }
            }
        }
        Note { x: 0; y: 210px; width: parent.width; text: App.level-note; }
        HorizontalLayout {
            x: 0; y: 266px;
            height: 38px;
            spacing: 10px;
            alignment: start;
            Button { kind: 3; text: "To Next Level"; clicked => { App.xp-to-next(); } }
            Button { kind: 3; text: "To Level " + App.max-level; clicked => { App.xp-to-max(); } }
        }
        Label { x: 0; y: 370px; text: "ALIGNMENT"; }
        Rectangle {
            x: 0; y: 404px;
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #b8333a 0%, #6a6a6a 50%, #3b8fe0 100%);
            Rectangle {
                x: parent.width * App.alignment / 100 - 2px;
                y: -6px;
                width: 4px;
                height: 26px;
                border-radius: 2px;
                background: App.alignment-changed ? Theme.changed : Theme.text;
            }
            TouchArea {
                y: -8px;
                height: parent.height + 16px;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (self.pressed) { App.set-alignment(Math.round(Math.clamp(self.mouse-x / parent.width * 100, 0, 100))); }
                }
                moved => { App.set-alignment(Math.round(Math.clamp(self.mouse-x / parent.width * 100, 0, 100))); }
            }
        }
        HorizontalLayout {
            x: 0; y: 426px;
            height: 20px;
            Note { text: "Dark side"; }
            Text {
                text: App.alignment;
                horizontal-alignment: center;
                font-family: Theme.body-font;
                font-size: 14px;
                color: App.alignment-changed ? Theme.changed : Theme.text;
            }
            Note { text: "Light side"; horizontal-alignment: right; }
        }
    }
    // Attributes
    Rectangle {
        x: colw + 34px;
        width: colw;
        Label { x: 0; y: 0; text: "ATTRIBUTES"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            for s[i] in App.attributes: StatLine { stat: s; set(v) => { App.set-attribute(i, v); } }
        }
        Note {
            x: 0; y: 32px + 6 * 60px + 10px;
            width: parent.width;
            text: "Base scores, before items and powers. The game works out Defence and saving throws from them.";
        }
    }
    // Health, Force, look
    Rectangle {
        x: 2 * (colw + 34px);
        width: colw;
        Label { x: 0; y: 0; text: "HEALTH AND FORCE"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            Line {
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Health"; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
                        Text { text: App.health-note; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; hn := Field { width: 72px; text: App.hp-current; changed: App.hp-changed; accepted(t) => { App.set-hp(hn.text.to-float(), hm.text.to-float()); } } }
                    VerticalLayout { alignment: center; hm := Field { width: 72px; text: App.hp-max; changed: App.hp-changed; accepted(t) => { App.set-hp(hn.text.to-float(), hm.text.to-float()); } } }
                }
            }
            Line {
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Force"; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
                        Text { text: App.force-note; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; fn := Field { width: 72px; text: App.fp-current; changed: App.fp-changed; accepted(t) => { App.set-fp(fn.text.to-float(), fm.text.to-float()); } } }
                    VerticalLayout { alignment: center; fm := Field { width: 72px; text: App.fp-max; changed: App.fp-changed; accepted(t) => { App.set-fp(fn.text.to-float(), fm.text.to-float()); } } }
                }
            }
        }
        HorizontalLayout {
            x: 0; y: 152px;
            height: 38px;
            spacing: 14px;
            alignment: start;
            Button { kind: 3; text: "Heal Everyone"; clicked => { App.heal-all(); } }
            VerticalLayout { alignment: center; Switch { on: App.min1hp; changed: App.min1hp-changed; toggled(v) => { App.set-min1hp(v); } } }
            Text { text: "Cannot die"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: Theme.muted; }
        }
        Label { x: 0; y: 214px; text: "LOOK AND VOICE"; }
        Rectangle {
            x: 0; y: 246px;
            width: 84px;
            height: 84px;
            border-radius: 5px;
            border-width: App.look-changed ? 2px : 1px;
            border-color: App.look-changed ? Theme.changed : Theme.edge;
            background: Theme.field;
            clip: true;
            if App.has-portrait: Image { source: App.portrait; width: parent.width; height: parent.height; }
            TouchArea { mouse-cursor: pointer; clicked => { App.open-look(); } }
        }
        VerticalLayout {
            x: 98px; y: 240px;
            width: parent.width - 98px;
            height: self.preferred-height;
            for f in [
                { label: "Portrait", value: "Change", which: 0 },
                { label: "Body", value: App.body-name, which: 1 },
                { label: "Voice", value: App.voice-name, which: 2 },
                { label: "Gender", value: App.gender-name, which: 3 },
            ]: Rectangle {
                height: 34px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 64px; text: f.label; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px; color: Theme.faint; }
                    Text { text: f.value; vertical-alignment: center; font-family: Theme.list-font; font-size: 15px; color: lk.has-hover ? Theme.accent : Theme.text; overflow: elide; }
                }
                lk := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (f.which == 0) { App.open-look(); }
                        if (f.which == 1) { App.open-body(); }
                        if (f.which == 2) { App.open-voice(); }
                        if (f.which == 3) { App.open-gender(); }
                    }
                }
            }
        }
    }
}

component AbilitiesTab inherits Rectangle {
    property <length> colw: (self.width - 2 * 34px) / 3;
    property <length> pick-w: (root.width - colw * 0.92 - 68px) / 2;
    Rectangle {
        x: 0;
        width: colw * 0.92;
        Label { x: 0; y: 0; text: "SKILLS"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            for s[i] in App.skills: StatLine { stat: s; label-size: 15px; height: 50px; set(v) => { App.set-skill(i, v); } }
        }
        Note { x: 0; y: 32px + App.skills.length * 50px + 10px; width: parent.width; text: "Ranks the character has bought. Items and attributes add on top in the game."; }
    }
    AbilityList {
        x: colw * 0.92 + 34px;
        width: pick-w;
        title: "FEATS · " + App.feat-count;
        placeholder: "Type to narrow the list";
        rows: App.feats;
        search(t) => { App.search-feats(t); }
        add(id) => { App.add-feat(id); }
        remove(id) => { App.remove-feat(id); }
    }
    AbilityList {
        x: colw * 0.92 + 34px + pick-w + 34px;
        width: pick-w;
        title: "FORCE POWERS · " + App.power-count;
        hint: App.power-note;
        enabled: App.can-powers;
        placeholder: App.can-powers ? "Type to narrow the list" : "Only a Jedi class learns Force powers";
        rows: App.powers;
        search(t) => { App.search-powers(t); }
        add(id) => { App.add-power(id); }
        remove(id) => { App.remove-power(id); }
    }
}

component ItemLine inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> editable: true;
    callback stack(int);
    callback remove();
    height: 50px;
    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.edge;
                background: Theme.field;
                clip: true;
                if item.has-icon: Image { source: item.icon; width: parent.width; height: parent.height; }
            }
        }
        VerticalLayout {
            alignment: center;
            Text { text: item.name; font-family: Theme.list-font; font-size: 17px; color: item.changed ? Theme.changed : Theme.text; overflow: elide; }
            Text { text: item.kind; font-family: Theme.body-font; font-size: 12px; color: Theme.faint; overflow: elide; }
        }
        if editable && item.max-stack > 1: VerticalLayout {
            alignment: center;
            Stepper { width: 130px; height: 34px; value: item.stack; minimum: 1; maximum: item.max-stack; changed: item.changed; font-size: 17px; set(v) => { root.stack(v); } }
        }
        if !editable || item.max-stack <= 1: Text {
            width: 130px;
            text: item.stack > 1 ? "× " + item.stack : "";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: Theme.list-font;
            font-size: 16px;
            color: Theme.muted;
        }
        if editable: Rectangle {
            width: 36px;
            Cross { colour: rm.has-hover ? Theme.danger : Theme.faint; }
            rm := TouchArea { mouse-cursor: pointer; clicked => { root.remove(); } }
        }
    }
}

component Money inherits Line {
    in property <string> label;
    in property <string> note;
    in property <int> value;
    in property <bool> changed;
    callback set(int);
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Text { text: label; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
            if note != "": Text { text: note; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; }
        }
        VerticalLayout {
            alignment: center;
            Field { width: min(170px, root.width - 150px); text: value; changed: changed; accepted(t) => { root.set(t.to-float()); } }
        }
    }
}

// The kinds of item as a row of tabs; on two rows when the row would not fit.
component KindTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback chosen;
    width: kt.preferred-width + 20px;
    height: 34px;
    border-radius: 5px;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.edge;
    background: on ? Theme.selected : kta.has-hover ? Theme.hover : Theme.field;
    kt := Text { text: root.text; font-family: Theme.list-font; font-size: 14px; color: on ? Theme.text : Theme.soft; }
    kta := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }
}

component KindTabs inherits Rectangle {
    in property <int> selected;
    callback chosen(int);
    // One row when the whole row fits, measured from a hidden copy of it.
    property <bool> one-row: root.width >= probe.preferred-width;
    probe := HorizontalLayout {
        y: 0;
        height: 34px;
        spacing: 6px;
        opacity: 0;
        for t in App.picker-tabs: KindTab { text: t; }
    }
    height: one-row ? 34px : 74px;
    HorizontalLayout {
        y: 0;
        height: 34px;
        spacing: 6px;
        alignment: start;
        for t[i] in (one-row ? App.picker-tabs : App.picker-tabs-a): KindTab {
            text: t;
            on: i == root.selected;
            chosen => { root.chosen(i); }
        }
    }
    if !one-row: HorizontalLayout {
        y: 40px;
        height: 34px;
        spacing: 6px;
        alignment: start;
        for t[i] in App.picker-tabs-b: KindTab {
            text: t;
            on: i + App.picker-tabs-a.length == root.selected;
            chosen => { root.chosen(i + App.picker-tabs-a.length); }
        }
    }
}

component InventoryTab inherits Rectangle {
    property <length> side: 300px;
    Rectangle {
        x: 0;
        width: side;
        Label { x: 0; y: 0; text: "SHARED BY THE PARTY"; }
        VerticalLayout {
            x: 0; y: 32px;
            height: self.preferred-height;
            Money { label: "Credits"; value: App.credits; changed: App.credits-changed; set(v) => { App.set-credits(v); } }
            if App.has-crafting: Money { label: "Components"; note: "For the workbench"; value: App.components; changed: App.components-changed; set(v) => { App.set-components(v); } }
            if App.has-crafting: Money { label: "Chemicals"; note: "For the lab station"; value: App.chemicals; changed: App.chemicals-changed; set(v) => { App.set-chemicals(v); } }
        }
        Note { x: 0; y: App.has-crafting ? 214px : 102px; width: parent.width; text: "Type a number and press Enter."; }
        Label { x: 0; y: App.has-crafting ? 250px : 138px; text: "EQUIPPED BY " + App.name; }
        Scroller {
            x: 0; y: (App.has-crafting ? 250px : 138px) + 30px;
            height: parent.height - self.y - 46px;
            content-height: App.slots.length * 46px;
            VerticalLayout {
                for r in App.slots: Rectangle {
                    height: 46px;
                    border-radius: 5px;
                    background: st.has-hover ? Theme.hover : transparent;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.edge;
                                background: Theme.field;
                                clip: true;
                                if r.has-icon: Image { source: r.icon; width: parent.width; height: parent.height; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: r.empty ? "Empty" : r.item; font-family: Theme.list-font; font-size: 15px; color: r.changed ? Theme.changed : r.empty ? Theme.faint : Theme.text; overflow: elide; }
                            Text { text: r.name; font-family: Theme.body-font; font-size: 11.5px; color: Theme.faint; overflow: elide; }
                        }
                    }
                    st := TouchArea { mouse-cursor: pointer; clicked => { App.open-slot(r.slot); } }
                }
            }
        }
        HorizontalLayout {
            x: 0; y: parent.height - 38px;
            height: 38px;
            alignment: start;
            Button { kind: 3; text: "Copy from Another Save"; clicked => { App.copy-inventory(); } }
        }
    }
    Rectangle {
        x: side + 34px;
        width: parent.width - self.x;
        Label { x: 0; y: 0; text: "INVENTORY · " + App.items.length; }
        kinds := KindTabs {
            x: 0;
            y: 32px;
            width: parent.width;
            selected: App.inventory-tab;
            chosen(i) => { App.select-inventory-tab(i); }
        }
        Scroller {
            x: 0; y: 32px + kinds.height + 14px;
            height: parent.height - self.y - 54px;
            content-height: App.items.length * 50px;
            VerticalLayout {
                for r[i] in App.items: ItemLine {
                    item: r;
                    stack(v) => { App.set-stack(r.index, v); }
                    remove => { App.remove-item(r.index); }
                }
            }
        }
        // Add Item: a full-width bar under the list, so it never covers a row.
        Rectangle {
            x: 0;
            y: parent.height - 44px;
            height: 44px;
            border-radius: 5px;
            border-width: 1px;
            border-color: fb.has-hover ? Theme.accent : Theme.edge;
            background: fb.has-hover ? Theme.hover : Theme.field;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                VerticalLayout { alignment: center; Sign { plus: true; colour: Theme.accent; } }
                Text { text: "Add Item"; vertical-alignment: center; font-family: Theme.list-font; font-size: 17px; color: Theme.accent; }
            }
            fb := TouchArea { mouse-cursor: pointer; clicked => { App.open-add-item(); } }
        }
    }
}

component PartyTab inherits Rectangle {
    HorizontalLayout {
        x: 0; y: 0;
        height: 24px;
        Label { text: "PARTY MEMBERS"; }
        Note { text: "With you: in the active party (two at most).  Recruited: in the party screen.  Can be picked: not held back by the story."; horizontal-alignment: right; vertical-alignment: center; }
    }
    Scroller {
        x: 0; y: 36px;
        height: parent.height - 36px - 70px;
        content-height: App.npcs.length * 76px;
        VerticalLayout {
            for n in App.npcs: Rectangle {
                height: 76px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Rectangle {
                        width: 58px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: n.in-party ? Theme.gold : Theme.edge;
                        background: Theme.field;
                        clip: true;
                        if n.has-portrait: Image { source: n.portrait; width: parent.width; height: parent.height; }
                    }
                    VerticalLayout {
                        alignment: center;
                        width: 160px;
                        Text { text: n.name; font-family: Theme.list-font; font-size: 19px; color: n.changed ? Theme.changed : Theme.text; }
                        Text {
                            text: n.in-party ? "In the party" : n.has-creature ? (n.recruited ? "Recruited" : "Not recruited") : "Not met in this save";
                            font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 140px;
                        VerticalLayout { alignment: center; Switch { on: n.recruited; enabled: n.has-creature; toggled(v) => { App.set-recruited(n.index, v); } } }
                        Text { text: "Recruited"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: n.has-creature ? Theme.muted : Theme.faint; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 130px;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: n.in-party;
                                enabled: n.has-creature && (n.in-party || App.party-size < 2);
                                toggled(v) => { App.set-in-party(n.index, v); }
                            }
                        }
                        Text { text: "With you"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: n.has-creature ? Theme.muted : Theme.faint; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        width: 160px;
                        VerticalLayout { alignment: center; Switch { on: n.selectable; toggled(v) => { App.set-selectable(n.index, v); } } }
                        Text { text: "Can be picked"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: Theme.muted; }
                    }
                    if n.has-influence: HorizontalLayout {
                        spacing: 10px;
                        width: 210px;
                        Text { text: "Influence"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: Theme.muted; }
                        VerticalLayout {
                            alignment: center;
                            Stepper { width: 140px; height: 36px; value: n.influence; minimum: 0; maximum: 100; font-size: 17px; set(v) => { App.set-influence(n.index, v); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button { kind: 3; text: n.has-creature ? "Replace" : "Bring In"; clicked => { App.import-npc(n.index); } }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        x: 0; y: parent.height - 56px;
        height: 56px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Text { text: "Party experience"; font-family: Theme.list-font; font-size: 19px; color: Theme.text; }
            Note { text: "Members who join later catch up to their share of it."; }
        }
        VerticalLayout {
            alignment: center;
            Field { width: 170px; text: App.party-xp; changed: App.party-xp-changed; accepted(t) => { App.set-party-xp(t.to-float()); } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component GlobalsSection inherits Rectangle {
    in-out property <string> query;
    in-out property <bool> changed-only;
    HorizontalLayout {
        x: 0; y: 0;
        height: 40px;
        spacing: 14px;
        Field {
            text <=> query;
            placeholder: "Type part of a name, for example tar_ or k_swg";
            font: Theme.body-font;
            font-size: 15px;
            edited(t) => { App.filter-globals(t, changed-only); }
        }
        HorizontalLayout {
            width: 230px;
            spacing: 10px;
            VerticalLayout { alignment: center; Switch { on: changed-only; toggled(v) => { changed-only = v; App.filter-globals(query, v); } } }
            Text { text: App.compare-name != "" ? "Only the differences" : "Only what I changed"; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; color: Theme.muted; }
        }
        Button { kind: 3; text: App.compare-name != "" ? "Compare Another" : "Compare with Another Save"; clicked => { App.open-compare(); } }
        if App.compare-name != "": Button { kind: 3; text: "Take All Theirs"; clicked => { App.use-all-other(); } }
    }
    Note { x: 0; y: 48px; width: parent.width; text: App.globals-note; }
    Scroller {
        x: 0; y: 76px;
        height: parent.height - 76px;
        content-height: App.variables.length * 46px;
        VerticalLayout {
            for g in App.variables: Rectangle {
                height: 46px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 14px;
                    Text { text: g.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 16px; color: g.changed ? Theme.changed : Theme.text; overflow: elide; }
                    Text { width: 90px; text: g.kind == 0 ? "switch" : g.kind == 1 ? "number" : "text"; vertical-alignment: center; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; }
                    Rectangle {
                        width: 170px;
                        if g.kind == 0: Switch { x: 0; y: (parent.height - self.height) / 2; on: g.on; changed: g.changed; toggled(v) => { App.set-global-bool(g.index, v); } }
                        if g.kind == 1: Stepper { x: 0; y: 4px; width: 150px; height: 36px; value: g.number; minimum: -128; maximum: 127; changed: g.changed; font-size: 16px; set(v) => { App.set-global-number(g.index, v); } }
                        if g.kind == 2: Field { y: 4px; height: 36px; text: g.text; changed: g.changed; font-size: 15px; accepted(t) => { App.set-global-text(g.index, t); } }
                    }
                    if App.compare-name != "": HorizontalLayout {
                        width: 230px;
                        spacing: 8px;
                        Text { text: g.other; vertical-alignment: center; horizontal-alignment: right; font-family: Theme.body-font; font-size: 14px; color: Theme.gold; overflow: elide; }
                        VerticalLayout { alignment: center; Button { kind: 3; text: "Take"; clicked => { App.use-other(g.index); } } }
                    }
                }
            }
        }
    }
}

component AreaSection inherits Rectangle {
    property <length> half: (self.width - 34px) / 2;
    Rectangle {
        width: half;
        x: 0;
        Label { x: 0; y: 0; text: "DOORS · " + App.doors.length; }
        Note { x: 0; y: 30px; width: parent.width; text: App.area-note; }
        Scroller {
            x: 0; y: 60px;
            height: parent.height - 60px;
            content-height: App.doors.length * 50px;
            VerticalLayout {
                for d in App.doors: Rectangle {
                    height: 50px;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: d.tag; font-family: Theme.list-font; font-size: 16px; color: d.changed ? Theme.changed : Theme.text; overflow: elide; }
                            Text { text: d.note; font-family: Theme.body-font; font-size: 12px; color: Theme.faint; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; Switch { on: d.locked; changed: d.changed; toggled(v) => { App.set-door-locked(d.index, v); } } }
                        Text { width: 60px; text: "Locked"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px; color: Theme.muted; }
                        VerticalLayout { alignment: center; Switch { on: d.open; changed: d.changed; toggled(v) => { App.set-door-open(d.index, v); } } }
                        Text { width: 46px; text: "Open"; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px; color: Theme.muted; }
                    }
                }
            }
        }
    }
    Rectangle {
        x: half + 34px;
        width: half;
        Label { x: 0; y: 0; text: "PLAYER POSITION  X  Y  HEIGHT"; }
        HorizontalLayout {
            x: 0; y: 30px;
            height: 40px;
            spacing: 8px;
            px := Field { text: App.position-x; changed: App.position-changed; font-size: 15px; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
            py := Field { text: App.position-y; changed: App.position-changed; font-size: 15px; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
            pz := Field { text: App.position-z; changed: App.position-changed; font-size: 15px; accepted(t) => { App.set-position(px.text, py.text, pz.text); } }
        }
        Label { x: 0; y: 92px; text: "CONTAINERS AND STORES"; }
        Scroller {
            x: 0; y: 128px;
            height: (parent.height - 128px) * 0.42;
            content-height: App.boxes.length * 44px;
            VerticalLayout {
                for b[i] in App.boxes: Rectangle {
                    height: 44px;
                    border-radius: 5px;
                    background: i == App.selected-box ? Theme.selected : bt.has-hover ? Theme.hover : transparent;
                    border-width: i == App.selected-box ? 1px : 0px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { text: b.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 16px; color: Theme.text; overflow: elide; }
                        Text { text: b.note; vertical-alignment: center; horizontal-alignment: right; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; }
                    }
                    bt := TouchArea { mouse-cursor: pointer; clicked => { App.select-box(i); } }
                }
            }
        }
        if App.selected-box >= 0: Rectangle {
            x: 0; y: 128px + (parent.height - 128px) * 0.42 + 12px;
            height: parent.height - self.y;
            HorizontalLayout {
                x: 0; y: 0;
                height: 38px;
                alignment: start;
                Button { kind: 3; text: "Add an Item Here"; clicked => { App.add-box-item(); } }
            }
            Scroller {
                x: 0; y: 48px;
                height: parent.height - 48px;
                content-height: App.box-items.length * 50px;
                VerticalLayout {
                    for r[i] in App.box-items: ItemLine { item: r; editable: true; remove => { App.remove-box-item(i); } }
                }
            }
        }
    }
}

component MoreSection inherits Rectangle {
    property <length> third: (self.width - 2 * 34px) / 3;
    Rectangle {
        x: 0;
        width: third;
        Label { x: 0; y: 0; text: "GALAXY MAP"; }
        Note { x: 0; y: 30px; width: parent.width; text: "Planets the Ebon Hawk can fly to."; }
        Scroller {
            x: 0; y: 60px;
            height: parent.height - 60px;
            content-height: App.planets.length * 44px;
            VerticalLayout {
                for p in App.planets: Rectangle {
                    height: 44px;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        Text { text: p.name; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; font-family: Theme.list-font; font-size: 16px; color: p.changed ? Theme.changed : Theme.text; }
                        VerticalLayout { alignment: center; Switch { on: p.on; changed: p.changed; toggled(v) => { App.set-planet(p.index, v); } } }
                    }
                }
            }
        }
    }
    Rectangle {
        x: third + 34px;
        width: third;
        Label { x: 0; y: 0; text: "PAZAAK SIDE CARDS"; }
        Note { x: 0; y: 30px; width: parent.width; text: "How many of each card the player owns, in the game's own card order."; }
        Scroller {
            x: 0; y: 60px;
            height: parent.height - 60px;
            content-height: App.pazaak.length * 46px;
            VerticalLayout {
                for c in App.pazaak: Rectangle {
                    height: 46px;
                    Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                    HorizontalLayout {
                        Text { text: c.name; vertical-alignment: center; font-family: Theme.list-font; font-size: 16px; color: c.changed ? Theme.changed : Theme.text; }
                        VerticalLayout {
                            alignment: center;
                            Stepper { width: 130px; height: 34px; value: c.value; minimum: 0; maximum: 9; changed: c.changed; font-size: 16px; set(v) => { App.set-pazaak(c.index, v); } }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        x: 2 * (third + 34px);
        width: third;
        Label { x: 0; y: 0; text: "CHEATS"; }
        HorizontalLayout {
            x: 0; y: 36px;
            height: 40px;
            spacing: 12px;
            VerticalLayout { alignment: center; Switch { on: App.cheat-used; changed: App.cheat-changed; toggled(v) => { App.set-cheat(v); } } }
            Text { text: "Marked as cheated"; vertical-alignment: center; font-family: Theme.list-font; font-size: 17px; color: Theme.text; }
        }
        Note { x: 0; y: 84px; width: parent.width; text: "The game sets this when the console's cheats are used. Turning it off clears the mark from the save."; }
        Label { x: 0; y: 286px; text: "TIME PLAYED"; }
        Note { x: 0; y: 362px; text: "Hours and minutes. Press Enter to keep a change."; }
        HorizontalLayout {
            x: 0; y: 318px;
            height: 40px;
            spacing: 8px;
            ph := Field { width: 90px; text: App.played-hours; changed: App.played-changed; accepted(t) => { App.set-played(ph.text, pm.text); } }
            pm := Field { width: 70px; text: App.played-minutes; changed: App.played-changed; accepted(t) => { App.set-played(ph.text, pm.text); } }
            Rectangle { }
        }
        Label { x: 0; y: 160px; text: "SAVE NAME"; }
        Field {
            x: 0;
            y: 194px;
            width: parent.width;
            text: App.save-name;
            changed: App.save-name-changed;
            accepted(t) => { App.set-save-name(t); }
        }
        Note { x: 0; y: 242px; width: parent.width; text: "What the game's Load screen calls this save. Press Enter to keep a change."; }
    }
}

component CreaturesSection inherits Rectangle {
    HorizontalLayout {
        x: 0; y: 0;
        height: 24px;
        Label { text: "CREATURES IN THE AREA · " + App.creatures.length; }
        Note { text: "Taking one out of the area removes it from the save; a creature a quest needs can leave the quest stuck."; horizontal-alignment: right; vertical-alignment: center; }
    }
    Scroller {
        x: 0; y: 36px;
        height: parent.height - 36px;
        content-height: App.creatures.length * 48px;
        VerticalLayout {
            for c in App.creatures: Rectangle {
                height: 48px;
                Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: c.name; font-family: Theme.list-font; font-size: 16px; color: Theme.text; overflow: elide; }
                        Text { text: c.note; font-family: Theme.body-font; font-size: 12px; color: Theme.faint; overflow: elide; }
                    }
                    Text { width: 120px; text: "Health " + c.hp + " / " + c.max-hp; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px; color: Theme.muted; }
                    Rectangle {
                        width: 36px;
                        Cross { colour: cr.has-hover ? Theme.danger : Theme.faint; }
                        cr := TouchArea { mouse-cursor: pointer; clicked => { App.remove-creature(c.index); } }
                    }
                }
            }
        }
    }
}

component JournalSection inherits Rectangle {
    HorizontalLayout {
        x: 0; y: 0;
        height: 24px;
        Label { text: "QUESTS"; }
        Note { text: App.journal-note; horizontal-alignment: right; vertical-alignment: center; }
    }
    Scroller {
        x: 0; y: 36px;
        height: parent.height - 36px;
        content-height: App.journal.length * 54px;
        VerticalLayout {
            for j[i] in App.journal: Rectangle {
                height: 54px;
                border-radius: 5px;
                background: j.owned ? Theme.selected : jq.has-hover && !j.header ? Theme.hover : transparent;
                if j.header: Label { x: 4px; y: 26px; text: j.name; font-size: 13px; color: Theme.soft; }
                if !j.header: Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.row-line; }
                jq := TouchArea { enabled: !j.header; mouse-cursor: pointer; clicked => { App.open-quest(j.id); } }
                if !j.header: HorizontalLayout {
                    padding-left: 8px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: j.name; font-family: Theme.list-font; font-size: 16px; color: j.changed ? Theme.changed : j.owned ? Theme.gold : Theme.text; overflow: elide; }
                        Text { text: j.note; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; overflow: elide; }
                    }
                    Rectangle {
                        width: 40px;
                        if j.owned: Cross { colour: jr.has-hover ? Theme.danger : Theme.faint; }
                        if !j.owned: Sign { plus: true; colour: Theme.accent; }
                        jr := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if (j.owned) { App.remove-journal(j.id); } else { App.open-quest(j.id); } }
                        }
                    }
                }
            }
        }
    }
}

component StoryTab inherits Rectangle {
    HorizontalLayout {
        x: 0; y: 0;
        height: 38px;
        spacing: 10px;
        alignment: start;
        for s[i] in ["Global Variables", "Area", "Creatures", "Quests", "Galaxy Map, Pazaak and More"]: Rectangle {
            width: t.preferred-width + 30px;
            border-radius: 5px;
            border-width: 1px;
            border-color: i == App.story-section ? Theme.accent : Theme.edge;
            background: i == App.story-section ? Theme.selected : st.has-hover ? Theme.hover : Theme.field;
            t := Text { text: s; font-family: Theme.list-font; font-size: 16px; color: i == App.story-section ? Theme.text : Theme.soft; }
            st := TouchArea { mouse-cursor: pointer; clicked => { App.select-story(i); } }
        }
    }
    Rectangle {
        x: 0; y: 58px;
        height: parent.height - 58px;
        if App.story-section == 0: GlobalsSection { }
        if App.story-section == 1: AreaSection { }
        if App.story-section == 2: CreaturesSection { }
        if App.story-section == 3: JournalSection { }
        if App.story-section == 4: MoreSection { }
    }
}

export component EditorPage inherits Rectangle {
    // Back to the saves, top left before the crest.
    BackArrow {
        x: 50px;
        y: 67px;
        clicked => { App.back(); }
    }
    // Tabs
    Rectangle {
        x: 60px;
        y: 170px;
        width: parent.width - 120px;
        height: 48px;
        Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: Theme.edge; }
        HorizontalLayout {
            alignment: start;
            for t[i] in ["Character", "Abilities", "Inventory", "Party", "Story"]: Rectangle {
                width: tt.preferred-width + 60px;
                tt := Text { y: 10px; text: t; font-family: Theme.list-font; font-size: 20px; color: i == App.tab ? Theme.text : ta.has-hover ? Theme.muted : Theme.soft; }
                if App.tab-changed[i]: Rectangle {
                    x: tt.x + tt.width + 6px;
                    y: 12px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.changed;
                }
                if i == App.tab: Rectangle { x: 0; y: parent.height - 3px; height: 3px; background: Theme.accent; }
                ta := TouchArea { mouse-cursor: pointer; clicked => { App.select-tab(i); } }
            }
        }
        Text {
            x: parent.width - self.width;
            y: 16px;
            text: App.context-line;
            font-family: Theme.body-font;
            font-size: 14px;
            color: Theme.faint;
        }
    }
    // The party
    Scroller {
        x: 60px;
        y: 240px;
        width: 262px;
        height: parent.height - 240px - 160px;
        content-height: App.members.length * 72px;
        VerticalLayout {
            spacing: 6px;
            for m[i] in App.members: Rectangle {
                height: 66px;
                border-radius: 6px;
                border-width: 1px;
                border-color: i == App.who ? Theme.accent : transparent;
                background: i == App.who ? Theme.selected : mt.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding: 7px;
                    spacing: 12px;
                    Rectangle {
                        width: 52px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.edge;
                        background: Theme.field;
                        clip: true;
                        if m.has-portrait: Image { source: m.portrait; width: parent.width; height: parent.height; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: m.name; font-family: Theme.list-font; font-size: 18px; color: m.changed ? Theme.changed : i == App.who ? Theme.gold : Theme.muted; overflow: elide; }
                        Text { text: m.sub; font-family: Theme.body-font; font-size: 12.5px; color: Theme.faint; overflow: elide; }
                    }
                }
                mt := TouchArea { mouse-cursor: pointer; clicked => { App.select-who(i); } }
            }
        }
    }
    // The tab
    Rectangle {
        x: 342px;
        y: 240px;
        width: parent.width - self.x - 60px;
        height: parent.height - 240px - 160px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-edge;
        border-radius: 10px;
        Rectangle {
            x: 26px;
            y: 22px;
            width: parent.width - 52px;
            height: parent.height - 44px;
            if App.tab == 0: CharacterTab { }
            if App.tab == 1: AbilitiesTab { }
            if App.tab == 2: InventoryTab { }
            if App.tab == 3: PartyTab { }
            if App.tab == 4: StoryTab { }
        }
    }
    // Save, revert, the backup
    HorizontalLayout {
        x: 60px;
        y: parent.height - 136px;
        width: parent.width - 120px;
        height: 64px;
        spacing: 14px;
        HorizontalLayout {
            width: 250px;
            spacing: 10px;
            alignment: start;
            if App.change-count > 0: Text {
                text: App.change-count;
                vertical-alignment: center;
                font-family: Theme.title-font;
                font-size: 24px;
                color: Theme.changed;
            }
            Text {
                text: App.change-count == 0 ? "No changes" : App.change-count == 1 ? "change" : "changes";
                vertical-alignment: center;
                font-family: Theme.title-font;
                font-size: 24px;
                color: Theme.text;
            }
        }
        Rectangle {
            border-width: 1px;
            border-color: App.status-bad ? Theme.danger : Theme.edge;
            border-radius: 6px;
            background: Theme.field;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                spacing: 4px;
                Text {
                    text: App.status != "" ? (App.status-bad ? "COULD NOT SAVE" : "SAVED") : "A BACKUP IS MADE BEFORE SAVING";
                    font-family: Theme.label-font;
                    font-size: 11px;
                    letter-spacing: 2px;
                    color: App.status-bad ? Theme.danger : App.status != "" ? Theme.good : Theme.faint;
                }
                Text {
                    text: App.status != "" ? App.status : App.backup-path;
                    font-family: Theme.body-font;
                    font-size: 14px;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
        }
        Button { width: 170px; text: "Revert"; kind: 2; enabled: App.change-count > 0; clicked => { App.revert(); } }
        Button { width: 330px; text: "Save Changes"; kind: 0; enabled: App.change-count > 0; clicked => { App.save-changes(); } }
    }
}
