// The KMRP colours: the Font Converter's navy and cyan for KotOR, a teal-green world
// for KotOR II (its own GUI's text colour, 26 178 140), each in a dark and a light mode.
// Type is KMRP's own Original HD Font: Menu for titles and buttons, Menu Medium for lists
// (the game's save list font), Menu Small B for spaced labels, Descriptions for text.

// kmrp-fonts.slint is written by build.rs: it embeds the four OTF files when they exist
// and is empty otherwise (a build without the game's files falls back to the system font).
import { KmrpFonts } from "kmrp-fonts.slint";

export global Theme {
    in-out property <bool> dark: true;
    in-out property <bool> k2: false;
    // Text size, from Settings: 0 Small (the first release's sizes), 1 Medium, 2 Large.
    in-out property <int> text-size: 1;
    out property <float> ts: text-size == 0 ? 1.0 : text-size == 1 ? 1.1 : 1.2;

    out property <string> title-font: "KMRP Original HD Menu";
    out property <string> list-font: "KMRP Original HD Menu Medium";
    out property <string> label-font: "KMRP Original HD Menu Small B";
    out property <string> body-font: "KMRP Original HD Descriptions";

    out property <color> window: dark ? (k2 ? #08130f : #0a1220) : (k2 ? #e9f2ee : #e8eef5);
    out property <color> glow: dark ? (k2 ? #123128 : #16243a) : (k2 ? #d4e7de : #d3e0ee);
    out property <color> panel: dark ? (k2 ? #0b1a15 : #0d1626) : (k2 ? #f8fcfa : #f8fafd);
    out property <color> panel-edge: dark ? (k2 ? #26503f : #2a3d5c) : (k2 ? #a9c4b8 : #b0c0d2);
    out property <color> field: dark ? (k2 ? #050d0a : #060b14) : (k2 ? #ffffff : #ffffff);
    // Edges about 3:1 against a field (2026-10-22; at 1.8:1 the buttons' edges were nearly invisible).
    out property <color> edge: dark ? (k2 ? #376a58 : #44608a) : (k2 ? #7f9f92 : #8497ad);
    out property <color> row-line: dark ? (k2 ? #143027 : #16233a) : (k2 ? #dcebe4 : #dde5ee);
    out property <color> selected: dark ? (k2 ? #0b2a20 : #0b1c2c) : (k2 ? #ddf3ea : #dcecf8);
    out property <color> hover: dark ? (k2 ? #0f2620 : #111f33) : (k2 ? #edf7f2 : #edf3f9);

    out property <color> accent: dark ? (k2 ? #2fcf9b : #2ac6ef) : (k2 ? #0f8a63 : #0a7fb0);
    out property <color> fill-top: k2 ? #46dcac : #2fd0f5;
    out property <color> fill-bottom: k2 ? #1fb486 : #1ab3e3;
    out property <color> fill-hover: k2 ? #66e8bf : #58def8;
    out property <color> ink: k2 ? #04140e : #06121e;

    out property <color> text: dark ? (k2 ? #eaf6f1 : #ecf3f8) : (k2 ? #0b211a : #0d1a2b);
    out property <color> muted: dark ? (k2 ? #acc8bd : #b1c3d0) : (k2 ? #3d5a4f : #44576c);
    out property <color> soft: dark ? (k2 ? #8aa89c : #8fa3b5) : (k2 ? #5b766b : #5d7086);
    out property <color> faint: dark ? (k2 ? #738f84 : #7a8a9a) : (k2 ? #4d665c : #56687c);

    out property <color> gold: dark ? #e2c35c : #7a5f08;
    out property <color> changed: dark ? #ff9a3c : #c75f00;
    out property <color> good: dark ? #7ee0ab : #1e8a52;
    out property <color> danger: dark ? #ff6b6b : #c0392b;
    out property <color> grey-top: dark ? #566272 : #c9d2dc;
    out property <color> grey-bottom: dark ? #424d5c : #b6c0cb;
    out property <color> scrim: dark ? #03060cbc : #1a2a3a66;
}
